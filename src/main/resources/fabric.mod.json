{
  "schemaVersion": 1,
  "id": "shut_up_dead_entities",
  "version": "1.2.1",
  "name": "Shut Up Dead Entities",
  "description": "A client-side mod that smoothly fades out mob sounds upon death. Mutes dead mobs by fading, silencing, and stopping persistent ghost audio from Endermens, Creepers and Nether portals.",
  "authors": [
    "diskria"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/shut_up_dead_entities",
    "sources": "https://github.com/diskria-minecraft/shut_up_dead_entities",
    "issues": "https://github.com/diskria-minecraft/shut_up_dead_entities/issues"
  },
  "license": "MIT",
  "icon": "assets/shut_up_dead_entities/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "io.github.diskria.shut_up_dead_entities.ShutUpDeadEntitiesMod",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    {
      "config": "shut_up_dead_entities.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "shut_up_dead_entities.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3",
    "java": ">=25",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0"
  }
}
